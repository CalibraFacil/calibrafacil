# Calibra Fácil, self-hosted: settings for compose.yaml.
#
# ./setup.sh copies this file to .env and fills in the secrets. Keep .env
# private and backed up: losing the master keys makes stored certificates'
# signing keys and integration tokens unreadable.
#
# Generated from packages/config (`pnpm config:env-example`): edit the schema
# there, not this file. A test fails when the two drift apart.

# ── Version ───────────────────────────────────────────────────────────────────
# Image tag on ghcr.io/calibrafacil. Pin it; change it to update.

# Version of the published images.
# x-release-please-start-version
CALIBRA_VERSION=0.3.0
# x-release-please-end

# ── Addresses ─────────────────────────────────────────────────────────────────
# Three DNS names pointing at this machine (no trailing slash). With https://
# Caddy gets certificates from Let's Encrypt; ports 80 and 443 must be open.
# To try it on your own computer, use http://app.localhost,
# http://portal.localhost and http://files.localhost.

# Address of the lab app (and of the API, under /api).
APP_URL=https://calibra.example.com

# Address of the client portal.
PORTAL_URL=https://portal.example.com

# Address file downloads are served from (the object store).
FILES_URL=https://files.example.com

# ── E-mail ────────────────────────────────────────────────────────────────────
# Sign-in is passwordless, so the app must be able to send e-mail. Use your
# provider's SMTP server (Gmail/Google Workspace, Microsoft 365, Amazon SES,
# Brevo, Mailgun, your own Postfix...), or set RESEND_API_KEY instead.
#
# Just trying it out? `./setup.sh --local` sets SMTP_HOST=mailpit,
# SMTP_PORT=1025 and COMPOSE_PROFILES=mailpit: every e-mail then lands in a
# test inbox at http://localhost:8025 instead of being delivered.

# Sender of platform e-mail, e.g. "Laboratório <calibra@example.com>".
EMAIL_FROM="Calibra Fácil <calibra@example.com>"

# SMTP server host. Leave empty to use Resend.
SMTP_HOST=

# SMTP port (default 587, or 465 with SMTP_SECURE=true).
SMTP_PORT=587

# Implicit TLS (port 465); otherwise STARTTLS when the server offers it.
SMTP_SECURE=false

# SMTP user name.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# Resend API key: the platform sender when SMTP_HOST is empty, and the fallback
# for lab sender domains.
# RESEND_API_KEY=

# ── Laboratory identity (legal pages) ─────────────────────────────────────────
# Whoever runs this instance is the data controller under the LGPD; these
# appear on the terms of use and privacy pages.

# Legal name of the operator.
OPERATOR_LEGAL_NAME=

# CNPJ of the operator.
OPERATOR_CNPJ=

# Address of the operator.
OPERATOR_ADDRESS=

# Contact e-mail of the operator.
OPERATOR_EMAIL=

# ── Certificate time-stamping (optional) ──────────────────────────────────────
# RFC 3161 carimbo do tempo on signed certificates. Leave SIGNING_TSA_URL
# empty and certificates are signed without a time-stamp. When it is set,
# every certificate is time-stamped and, if the authority cannot be
# reached, the certificate is not issued (see DEPLOYMENT.md).

# RFC 3161 time-stamp authority endpoint. In local or inline job mode an
# unreachable authority rejects the job on the first try, so leave it unset in
# development.
# SIGNING_TSA_URL=

# Full Authorization header value for a contracted time-stamp authority (e.g.
# `Basic ...` or `Bearer ...`).
# SIGNING_TSA_AUTH=

# `true` only when the endpoint is a credentialed ICP-Brasil authority;
# otherwise signatures record icpBrasilConformant=false.
# SIGNING_TSA_ICP_CONFORMANT=false

# Time-stamp request timeout in milliseconds (1000 to 60000). Unset: 30000.
# Capped at 60 s so four tries (plus 7 s of back-off) stay under the queue
# function's 300 s limit. A request that times out fails the certificate job
# (fail-closed).
# SIGNING_TSA_TIMEOUT_MS=30000

# ── Outbound requests to customer-configured URLs (optional) ──────────────────
# Webhooks and the generic HTTP ERP integration call URLs a laboratory
# configures. They are refused when the host resolves to a private address
# (see DEPLOYMENT.md). List a host here only to reach, say, an ERP on your LAN.

# Comma-separated hosts the server may call even though they resolve to a
# private address, for a self-hosted laboratory whose ERP lives on its LAN. Each
# entry is a host name (`erp.lan`), a `*.suffix` wildcard, an IP address or a
# CIDR range (`10.20.0.0/24`). A host name permits ANY address it resolves to
# (loopback and the internal network included), so list a name only if you
# control its DNS; an IP address or CIDR range permits exactly those addresses.
# Off by default: list only what you mean to reach.
# OUTBOUND_ALLOW_PRIVATE_HOSTS=erp.lan,10.20.0.0/24

# `true` lets customer-configured URLs use plain http in production. Outside
# production (development, tests) http is always allowed.
# OUTBOUND_ALLOW_INSECURE_HTTP=false

# ── Optional ──────────────────────────────────────────────────────────────────

# Publish Caddy's HTTP port on another address, e.g. 127.0.0.1:8080.
# HTTP_BIND=80

# Publish Caddy's HTTPS port on another address.
# HTTPS_BIND=443

# Where the optional test inbox (COMPOSE_PROFILES=mailpit) is published.
# MAILPIT_BIND=127.0.0.1:8025

# ── Logs and memory limits (optional) ─────────────────────────────────────────
# Every service rotates its container logs and is capped in memory, so one
# runaway process cannot take the whole machine down. The defaults suit a
# laboratory on a 4 GB server (limits are ceilings, not reservations: the
# sum may exceed the RAM). Raise a limit if `docker compose ps` shows a
# service restarting with exit code 137 (killed for memory).

# Largest container log file before Docker rotates it.
# LOG_MAX_SIZE=10m

# Rotated log files kept per container.
# LOG_MAX_FILE=5

# Memory limit of the API.
# MEM_LIMIT_API=1g

# Memory limit of the background worker (certificate signing and PDF handling).
# MEM_LIMIT_WORKER=1g

# Memory limit of the one-shot `init` (schema and migrations).
# MEM_LIMIT_INIT=1g

# Memory limit of the lab app's static server.
# MEM_LIMIT_WEB=192m

# Memory limit of the client portal's static server.
# MEM_LIMIT_PORTAL=192m

# Memory limit of PostgreSQL. Do not set it below what shared_buffers and your
# connections need: an out-of-memory kill of the database is the worst outcome
# here.
# MEM_LIMIT_POSTGRES=1g

# Memory limit of the bundled object store.
# MEM_LIMIT_S3=512m

# Memory limit of the PDF renderer (Chromium and LibreOffice), the heaviest
# service.
# MEM_LIMIT_GOTENBERG=1536m

# Memory limit of the HTTPS proxy.
# MEM_LIMIT_CADDY=256m

# Memory limit of the optional test inbox.
# MEM_LIMIT_MAILPIT=128m

# Memory limit of the optional backup service.
# MEM_LIMIT_BACKUP=256m

# ── Database timeouts of the application role (optional) ──────────────────────
# `init` sets these on the calibra_app role only (ALTER ROLE ... SET), so a
# runaway statement or a forgotten open transaction is ended by the server.
# The owner role, migrations and the system sweeps are not affected. 0 turns
# a timeout off. They apply to new connections: restart the API and worker.

# statement_timeout of calibra_app, in milliseconds. Default 120000 (2 minutes).
# DB_APP_STATEMENT_TIMEOUT_MS=120000

# idle_in_transaction_session_timeout of calibra_app, in milliseconds. Default
# 60000 (1 minute).
# DB_APP_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ── Backups (optional, COMPOSE_PROFILES=backup) ───────────────────────────────
# A daily pg_dump plus a mirror of the object-store buckets, kept in BACKUP_DIR
# on this machine. Copy them off the machine too (BACKUP_OFFSITE_*, or your own
# tool). Read docs/operations/backup-restore.md before relying on them; test a
# restore. The master keys in .env are NOT part of the backup: keep .env safe
# separately.

# Compose profiles to start: `backup` (scheduled backups), `mailpit` (test
# inbox). Comma-separated.
# COMPOSE_PROFILES=backup

# Where the backup service writes (host path, relative to deploy/). Contains
# personal data: keep it private.
# BACKUP_DIR=./backups

# Time of the daily backup, HH:MM in UTC.
# BACKUP_SCHEDULE=02:30

# `true` also takes a backup shortly after the service starts (so every `docker
# compose up` leaves a fresh one).
# BACKUP_ON_START=true

# Days to keep database dumps.
# BACKUP_RETENTION_DAYS=14

# Newest dumps that are never deleted, however old (a stopped service must not
# empty the folder).
# BACKUP_KEEP_MIN=3

# age public key(s), comma-separated: dumps are encrypted to them (age-keygen
# makes the pair; keep the private key OFF this machine). Empty: dumps are not
# encrypted.
# BACKUP_AGE_RECIPIENT=age1...

# `false` skips the mirror of the object-store buckets (certificate PDFs,
# uploads).
# BACKUP_FILES=true

# s3://bucket/prefix of an off-site copy of BACKUP_DIR (any S3-compatible
# store). Empty: no off-site copy.
# BACKUP_OFFSITE_URI=s3://my-backups/calibra

# Endpoint of the off-site store; empty for AWS S3 (e.g.
# https://<account>.r2.cloudflarestorage.com for R2).
# BACKUP_OFFSITE_ENDPOINT=

# Region of the off-site store (default us-east-1; auto for R2).
# BACKUP_OFFSITE_REGION=

# Access key of the off-site store (write-only is enough).
# BACKUP_OFFSITE_ACCESS_KEY_ID=

# Secret key of the off-site store.
# BACKUP_OFFSITE_SECRET_ACCESS_KEY=

# ── Secrets (generated by ./setup.sh) ─────────────────────────────────────────
# 32 random bytes, base64, for the keys. Never change a key once data exists.

# Password of the bundled PostgreSQL's owner role (migrations, the system path).
POSTGRES_PASSWORD=

# Password of calibra_app, the role the API and worker connect as (row-level
# security binds it). `init` creates the login and sets this password on every
# start.
CALIBRA_APP_PASSWORD=

# Secret key of the bundled object store.
S3_SECRET_KEY=

# Session signing secret, at least 32 characters (generated by setup).
BETTER_AUTH_SECRET=

# Shared secret for the /api/cron/* endpoints (Authorization: Bearer). Without
# it the cron endpoints answer 503.
CRON_SECRET=

# Pepper for public quote approval-code HMACs (random string). Rotating it
# orphans outstanding codes.
QUOTE_APPROVAL_CODE_PEPPER=

# 256-bit base64 key encrypting the laboratories' signing-certificate passwords
# at rest (generated by setup). Never change it once certificates exist; never
# reuse another key.
SIGNING_MASTER_KEY=

# 256-bit base64 key encrypting integration tokens at rest (generated by setup).
# Never reuse another key.
INTEGRATIONS_MASTER_KEY=

# 256-bit base64 key encrypting public-API webhook secrets at rest (generated by
# setup). Never reuse another key.
PUBLIC_API_MASTER_KEY=

# 256-bit base64 key encrypting lab-owned Resend API keys at rest. Without it
# the e-mail-domain settings refuse key intake and every send uses the platform
# sender. Never reuse another key.
EMAIL_DOMAIN_MASTER_KEY=
