# Calibra Fácil, self-hosted: settings for compose.yaml.
#
# ./setup.sh copies this file to .env and fills in the secrets. Keep .env
# private and backed up: losing the master keys makes stored certificates'
# signing keys and integration tokens unreadable.

# ── Version ──────────────────────────────────────────────────────────────────
# Image tag on ghcr.io/calibrafacil. Pin it; change it to update.
# x-release-please-start-version
CALIBRA_VERSION=0.1.0
# x-release-please-end

# ── Addresses ────────────────────────────────────────────────────────────────
# Three DNS names pointing at this machine (no trailing slash). With https://
# Caddy gets certificates from Let's Encrypt; ports 80 and 443 must be open.
# To try it on your own computer, use http://app.localhost,
# http://portal.localhost and http://files.localhost.
APP_URL=https://calibra.example.com
PORTAL_URL=https://portal.example.com
FILES_URL=https://files.example.com

# ── E-mail ───────────────────────────────────────────────────────────────────
# Sign-in is passwordless, so the app must be able to send e-mail. Use your
# provider's SMTP server (Gmail/Google Workspace, Microsoft 365, Amazon SES,
# Brevo, Mailgun, your own Postfix…), or set RESEND_API_KEY instead.
EMAIL_FROM="Calibra Fácil <calibra@example.com>"
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); otherwise STARTTLS when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# RESEND_API_KEY=
#
# Just trying it out? `./setup.sh --local` sets SMTP_HOST=mailpit,
# SMTP_PORT=1025 and COMPOSE_PROFILES=mailpit: every e-mail then lands in a
# test inbox at http://localhost:8025 instead of being delivered.

# ── Laboratory identity (legal pages) ────────────────────────────────────────
# Whoever runs this instance is the data controller under the LGPD; these
# appear on the terms of use and privacy pages.
OPERATOR_LEGAL_NAME=
OPERATOR_CNPJ=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Server-side error reports (Sentry DSN). Unset = off.
# SENTRY_DSN=
# Publish Caddy on other addresses, e.g. HTTP_BIND=127.0.0.1:8080.
# HTTP_BIND=80
# HTTPS_BIND=443

# ── Secrets (generated by ./setup.sh) ────────────────────────────────────────
POSTGRES_PASSWORD=
S3_SECRET_KEY=
BETTER_AUTH_SECRET=
CRON_SECRET=
QUOTE_APPROVAL_CODE_PEPPER=
# 32 random bytes, base64. Never change them once data exists.
SIGNING_MASTER_KEY=
INTEGRATIONS_MASTER_KEY=
PUBLIC_API_MASTER_KEY=
EMAIL_DOMAIN_MASTER_KEY=
