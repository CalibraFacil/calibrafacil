# Calibra Fácil, self-hosted: settings for compose.yaml.
#
# ./setup.sh copies this file to .env and fills in the secrets. Keep .env
# private and backed up: losing the master keys makes stored certificates'
# signing keys and integration tokens unreadable.
#
# Generated from packages/config (`pnpm config:env-example`): edit the schema
# there, not this file. A test fails when the two drift apart.

# ── Version ───────────────────────────────────────────────────────────────────
# Image tag on ghcr.io/calibrafacil. Pin it; change it to update.

# Version of the published images.
# x-release-please-start-version
CALIBRA_VERSION=0.3.0
# x-release-please-end

# ── Addresses ─────────────────────────────────────────────────────────────────
# Three DNS names pointing at this machine (no trailing slash). With https://
# Caddy gets certificates from Let's Encrypt; ports 80 and 443 must be open.
# To try it on your own computer, use http://app.localhost,
# http://portal.localhost and http://files.localhost.

# Address of the lab app (and of the API, under /api).
APP_URL=https://calibra.example.com

# Address of the client portal.
PORTAL_URL=https://portal.example.com

# Address file downloads are served from (the object store).
FILES_URL=https://files.example.com

# ── E-mail ────────────────────────────────────────────────────────────────────
# Sign-in is passwordless, so the app must be able to send e-mail. Use your
# provider's SMTP server (Gmail/Google Workspace, Microsoft 365, Amazon SES,
# Brevo, Mailgun, your own Postfix...), or set RESEND_API_KEY instead.
#
# Just trying it out? `./setup.sh --local` sets SMTP_HOST=mailpit,
# SMTP_PORT=1025 and COMPOSE_PROFILES=mailpit: every e-mail then lands in a
# test inbox at http://localhost:8025 instead of being delivered.

# Sender of platform e-mail, e.g. "Laboratório <calibra@example.com>".
EMAIL_FROM="Calibra Fácil <calibra@example.com>"

# SMTP server host. Leave empty to use Resend.
SMTP_HOST=

# SMTP port (default 587, or 465 with SMTP_SECURE=true).
SMTP_PORT=587

# Implicit TLS (port 465); otherwise STARTTLS when the server offers it.
SMTP_SECURE=false

# SMTP user name.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# Resend API key: the platform sender when SMTP_HOST is empty, and the fallback
# for lab sender domains.
# RESEND_API_KEY=

# ── Laboratory identity (legal pages) ─────────────────────────────────────────
# Whoever runs this instance is the data controller under the LGPD; these
# appear on the terms of use and privacy pages.

# Legal name of the operator.
OPERATOR_LEGAL_NAME=

# CNPJ of the operator.
OPERATOR_CNPJ=

# Address of the operator.
OPERATOR_ADDRESS=

# Contact e-mail of the operator.
OPERATOR_EMAIL=

# ── Certificate time-stamping (optional) ──────────────────────────────────────
# RFC 3161 carimbo do tempo on signed certificates. Leave SIGNING_TSA_URL
# empty and certificates are signed without a time-stamp. When it is set,
# every certificate is time-stamped and, if the authority cannot be
# reached, the certificate is not issued (see DEPLOYMENT.md).

# RFC 3161 time-stamp authority endpoint. In local or inline job mode an
# unreachable authority rejects the job on the first try, so leave it unset in
# development.
# SIGNING_TSA_URL=

# Full Authorization header value for a contracted time-stamp authority (e.g.
# `Basic ...` or `Bearer ...`).
# SIGNING_TSA_AUTH=

# `true` only when the endpoint is a credentialed ICP-Brasil authority;
# otherwise signatures record icpBrasilConformant=false.
# SIGNING_TSA_ICP_CONFORMANT=false

# Time-stamp request timeout in milliseconds (1000 to 60000). Unset: 30000.
# Capped at 60 s so four tries (plus 7 s of back-off) stay under the queue
# function's 300 s limit. A request that times out fails the certificate job
# (fail-closed).
# SIGNING_TSA_TIMEOUT_MS=30000

# ── Optional ──────────────────────────────────────────────────────────────────

# Publish Caddy's HTTP port on another address, e.g. 127.0.0.1:8080.
# HTTP_BIND=80

# Publish Caddy's HTTPS port on another address.
# HTTPS_BIND=443

# Where the optional test inbox (COMPOSE_PROFILES=mailpit) is published.
# MAILPIT_BIND=127.0.0.1:8025

# ── Secrets (generated by ./setup.sh) ─────────────────────────────────────────
# 32 random bytes, base64, for the keys. Never change a key once data exists.

# Password of the bundled PostgreSQL.
POSTGRES_PASSWORD=

# Secret key of the bundled object store.
S3_SECRET_KEY=

# Session signing secret, at least 32 characters (generated by setup).
BETTER_AUTH_SECRET=

# Shared secret for the /api/cron/* endpoints (Authorization: Bearer). Without
# it the cron endpoints answer 503.
CRON_SECRET=

# Pepper for public quote approval-code HMACs (random string). Rotating it
# orphans outstanding codes.
QUOTE_APPROVAL_CODE_PEPPER=

# 256-bit base64 key encrypting the laboratories' signing-certificate passwords
# at rest (generated by setup). Never change it once certificates exist; never
# reuse another key.
SIGNING_MASTER_KEY=

# 256-bit base64 key encrypting integration tokens at rest (generated by setup).
# Never reuse another key.
INTEGRATIONS_MASTER_KEY=

# 256-bit base64 key encrypting public-API webhook secrets at rest (generated by
# setup). Never reuse another key.
PUBLIC_API_MASTER_KEY=

# 256-bit base64 key encrypting lab-owned Resend API keys at rest. Without it
# the e-mail-domain settings refuse key intake and every send uses the platform
# sender. Never reuse another key.
EMAIL_DOMAIN_MASTER_KEY=
