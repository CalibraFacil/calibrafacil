{
  // Cloudflare Worker + Container that drains the `app_queue_job` table and
  // assembles documents (calibration certificates, service-order PDFs, PDF
  // labels) off Vercel. Requires the Workers Paid plan. Deploy with
  // `wrangler deploy` — it builds Dockerfile.document-worker from the repo root
  // and pushes the image to Cloudflare's managed registry.
  //
  // Secrets are NOT in this file. Set them with `wrangler secret put <NAME>`
  // (see README.md for the full list). They reach the container process via the
  // DocumentWorkerContainer.envVars wiring in src/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calibrafacil-document-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "observability": { "enabled": true },

  // Non-secret tuning, forwarded to the container via envVars. The queue does
  // NOT poll on an interval here — the container drains on demand when the API
  // pings POST /drain — so QUEUE_POLL_INTERVAL_MS is intentionally absent.
  "vars": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "QUEUE_BATCH_SIZE": "10",
    "QUEUE_STALE_AFTER_MS": "600000",
    // Non-secret runtime config — these MUST live here, not just in the
    // dashboard: `wrangler deploy` treats `vars` as authoritative and wipes any
    // dashboard-added plaintext var not listed here. GOTENBERG_URL is what
    // routes XLSX/HTML → PDF to Gotenberg (without it the worker falls back to
    // local LibreOffice, which the container does not have).
    "GOTENBERG_URL": "https://calibrafacil-gotenberg.example.workers.dev",
    "APP_URL": "https://calibrafacil.com",
    "RESEND_FROM_EMAIL": "no-reply@calibrafacil.com",
  },

  // standard-2 = 1 vCPU / 6 GiB / 12 GB disk, matching services/gotenberg.
  // Assembly delegates rendering to Gotenberg over HTTP, so it is not
  // CPU-bound; 6 GiB is generous. max_instances 1 keeps a single drainer
  // (claimQueueJobs uses FOR UPDATE SKIP LOCKED, so this is safe either way).
  "containers": [
    {
      "name": "document-worker",
      "class_name": "DocumentWorkerContainer",
      "image": "../../Dockerfile.document-worker",
      "image_build_context": "../../",
      "instance_type": "standard-2",
      "max_instances": 1,
    },
  ],

  // Containers are backed by a Durable Object class.
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENT_WORKER_CONTAINER",
        "class_name": "DocumentWorkerContainer",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DocumentWorkerContainer"] },
  ],
}
