# Docker build context excludes. The container Dockerfiles
# (Dockerfile.document-worker, Dockerfile.worker) run `COPY . .` followed by
# `pnpm install --frozen-lockfile`, so host install/build artifacts must NOT
# leak into the context or image — they bloat the upload and can bake in
# wrong-arch native binaries (e.g. @resvg/resvg-js). Both bare and **/ forms
# are kept so root-level dirs are excluded on every Docker/BuildKit version.
.git
.github
node_modules
**/node_modules
.turbo
**/.turbo
dist
**/dist
coverage
**/coverage
.next
**/.next
.wrangler
**/.wrangler
.vercel
**/.vercel
apps/api/vercel-functions
**/*.tsbuildinfo
playwright-report
**/playwright-report
test-results
**/test-results

# Local env + logs (never bake secrets into an image)
.env
.env.*
.dev.vars
*.log
.DS_Store
