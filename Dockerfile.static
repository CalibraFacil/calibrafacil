# A frontend (APP_NAME=web for the lab app, portal for the client portal),
# built with Vite and served by a small Bun server. Build from the repository
# root:
#
#   docker build -f Dockerfile.static --build-arg APP_NAME=web \
#     --build-arg VITE_API_URL=https://api.example.com -t calibrafacil-web .
#
# VITE_API_URL is baked into the bundle. Leave it out when a reverse proxy
# serves the API under /api on the app's own origin.
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build

ARG APP_NAME
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# pnpm itself comes from the "packageManager" field of package.json.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /repo
COPY . .
RUN test -n "$APP_NAME" || (echo "Pass --build-arg APP_NAME=web or APP_NAME=portal" && false)
RUN pnpm install --frozen-lockfile --filter "@calibra-facil/${APP_NAME}..."
RUN pnpm --filter "@calibra-facil/${APP_NAME}" build

# The Bun of .bun-version (what CI runs), pinned by digest; Dependabot bumps both.
FROM oven/bun:1.4.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4

ARG APP_NAME
ENV PORT=8080
ENV STATIC_DIR=/app/dist
WORKDIR /app

COPY --from=build /repo/scripts/static-server.ts ./static-server.ts
COPY --from=build /repo/apps/${APP_NAME}/dist ./dist

# Run as the image's unprivileged user (uid 1000). The application is read-only
# on disk: everything it keeps goes to the database and the object store.
USER bun
EXPOSE 8080
CMD ["bun", "static-server.ts"]
