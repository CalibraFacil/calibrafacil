{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "bun ../../scripts/setup-private-git-ssh.mjs --required && pnpm install --frozen-lockfile --filter \"@calibra-facil/api...\"",
  "buildCommand": "bun scripts/build-vercel-deployment.mjs",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs api",
  "regions": ["gru1"],
  "functions": {
    "api/[...route].js": {
      "maxDuration": 30
    },
    "api/index.js": {
      "maxDuration": 30
    },
    "api/queues/background.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "calibra-facil-background-jobs"
        }
      ]
    },
    "api/cron/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/integrations",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/api/cron/integrations",
      "destination": "/api/cron/integrations"
    },
    {
      "source": "/api/cron/notifications",
      "destination": "/api/cron/notifications"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
