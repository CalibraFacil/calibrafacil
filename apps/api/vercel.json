{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "pnpm install --frozen-lockfile --filter \"@calibra-facil/api...\"",
  "buildCommand": "bun scripts/build-vercel-deployment.mjs",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs api",
  "regions": ["gru1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/queues/background.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "calibra-facil-background-jobs"
        }
      ]
    },
    "api/cron/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/integrations",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/portal-digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/operator-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/auth-maintenance",
      "schedule": "30 4 * * 1"
    },
    {
      "path": "/api/cron/service-order-emails",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/api/:path((?!cron/).*)",
      "destination": "/api"
    }
  ]
}
