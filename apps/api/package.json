{
  "name": "@calibra-facil/api",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/bun.ts",
    "dev:bun": "bun --watch src/bun.ts",
    "build": "tsc --project tsconfig.build.json --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "bun src/bun.ts",
    "init": "bun src/cli/init.ts",
    "create-lab": "bun src/cli/create-lab.ts",
    "soft-delete-lab": "bun src/cli/soft-delete-lab.ts",
    "seed:demo": "bun src/cli/seed-demo.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "rls:shadow-report": "node scripts/rls-shadow-report.mjs",
    "lint": "oxlint",
    "check-types": "node ../../scripts/typecheck.mjs --project tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@calibra-facil/auth": "workspace:^",
    "@calibra-facil/certificate-data": "workspace:^",
    "@calibra-facil/config": "workspace:^",
    "@calibra-facil/contracts": "workspace:^",
    "@calibra-facil/db": "workspace:^",
    "@calibra-facil/documents": "workspace:^",
    "@calibra-facil/email": "workspace:^",
    "@calibra-facil/email-sender": "workspace:^",
    "@calibra-facil/interval-analysis": "workspace:^",
    "@calibra-facil/jobs-core": "workspace:^",
    "@calibra-facil/label-rendering": "workspace:^",
    "@calibra-facil/math-engine": "workspace:^",
    "@calibra-facil/method-definition": "workspace:^",
    "@calibra-facil/method-templates": "workspace:^",
    "@calibra-facil/notifications": "workspace:^",
    "@calibra-facil/schemas": "workspace:^",
    "@calibra-facil/shared": "workspace:^",
    "@calibra-facil/signing": "workspace:^",
    "@hono/zod-validator": "^0.8.0",
    "@scalar/hono-api-reference": "^0.10.20",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "kysely": "^0.28.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^24.13.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
