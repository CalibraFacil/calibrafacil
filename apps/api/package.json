{
  "name": "@calibra-facil/api",
  "version": "0.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/bun.ts",
    "dev:bun": "bun --watch src/bun.ts",
    "build": "echo 'API build handled by Docker/Fly'",
    "typecheck": "tsgo --noEmit",
    "start": "bun src/bun.ts",
    "deploy": "flyctl deploy -c ../../fly.api.toml --ha=false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@calibra-facil/auth": "workspace:^",
    "@calibra-facil/db": "workspace:^",
    "@calibra-facil/notifications": "workspace:^",
    "@calibra-facil/schemas": "workspace:^",
    "@calibra-facil/shared": "workspace:^",
    "@calibra-facil/signing": "workspace:^",
    "@hono/standard-validator": "^0.2.2",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.10.5",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.4",
    "hono-openapi": "^1.3.0",
    "kysely": "^0.28.14",
    "resend": "^6.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251230.0",
    "@repo/typescript-config": "workspace:^",
    "@vitest/coverage-v8": "^4.0.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
