{
  "name": "@calibra-facil/api",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/bun.ts",
    "dev:bun": "bun --watch src/bun.ts",
    "dev:checkout-offer": "bun scripts/dev-checkout-offer.ts",
    "build": "tsc --project tsconfig.build.json --noEmit && node scripts/build-vercel-functions.mjs",
    "build:vercel-functions": "node scripts/build-vercel-functions.mjs",
    "typecheck": "tsc --noEmit",
    "start": "bun src/bun.ts",
    "deploy": "pnpm dlx vercel deploy --prod",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint",
    "check-types": "tsc --project tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@calibra-facil/auth": "workspace:^",
    "@calibra-facil/certificate-data": "workspace:^",
    "@calibra-facil/contracts": "workspace:^",
    "@calibra-facil/db": "workspace:^",
    "@calibra-facil/documents": "workspace:^",
    "@calibra-facil/email": "workspace:^",
    "@calibra-facil/email-sender": "workspace:^",
    "@calibra-facil/interval-analysis": "workspace:^",
    "@calibra-facil/label-rendering": "workspace:^",
    "@calibra-facil/math-engine": "workspace:^",
    "@calibra-facil/method-definition": "workspace:^",
    "@calibra-facil/method-templates": "workspace:^",
    "@calibra-facil/notifications": "workspace:^",
    "@calibra-facil/schemas": "workspace:^",
    "@calibra-facil/shared": "workspace:^",
    "@calibra-facil/signing": "workspace:^",
    "@calibra-facil/worker": "workspace:^",
    "@cj-tech-master/excelts": "^9.6.0",
    "@hono/standard-validator": "^0.2.2",
    "@hono/zod-validator": "^0.8.0",
    "@resvg/resvg-js": "2.6.2",
    "@scalar/hono-api-reference": "^0.10.20",
    "@vercel/queue": "^0.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "hono-openapi": "^1.3.0",
    "kysely": "^0.28.17",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^24.13.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.0.17",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  }
}
