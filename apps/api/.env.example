# Calibra Fácil API — environment variables.
#
# `pnpm setup:dev` copies this file to apps/api/.env (gitignored) and fills the
# empty secrets with random values. The defaults point at the services started
# by docker-compose.yml, so local development needs no external account.
#
# Generated from packages/config (`pnpm config:env-example`): edit the schema
# there, not this file. A test fails when the two drift apart.

# ── Core ──────────────────────────────────────────────────────────────────────
# Execution mode and the address the API listens on. The public addresses
# (API_URL, APP_URL, ...) are under Addresses.

# Execution mode. `production` makes the variables marked required in production
# mandatory. Default: development.
NODE_ENV=development

# HTTP port of the API (and of the document-worker drain server). Falls back to
# API_PORT, then 3000 (8080 for the worker).
# PORT=3000

# On SIGTERM/SIGINT the API and the worker stop taking new work and wait this
# long for what is running (a certificate render, a request) before they give up
# and exit. Keep the container's stop_grace_period above it (default 25
# seconds). An unusable value means the default. Default: 25000.
# SHUTDOWN_GRACE_MS=25000

# Address the API binds to. Default: 0.0.0.0.
# HOST=0.0.0.0

# How many reverse proxies in front of the API are trusted to append the
# client's address to X-Forwarded-For (1 behind the Caddy of
# deploy/compose.yaml). 0 (the default) ignores the forwarded headers and uses
# the connection's own address: a header a client sent is never believed unless
# a trusted proxy wrote it. Used for the audit trail's IP, rate limits and
# throttles. Default: 0.
# TRUSTED_PROXY_HOPS=1

# Largest request body the API accepts, in bytes (413 above it). Uploads of
# attachments and certificates go to the object store directly; this bounds JSON
# and form bodies. Default 26214400 (25 MiB). Default: 26214400.
# API_MAX_BODY_BYTES=26214400

# Requests per minute one client may make to the API before it is answered 429
# with Retry-After (per signed-in user, else per client address; per API key on
# the public API). 0 turns the limiter off. Default 600. Default: 600.
# API_RATE_LIMIT_PER_MINUTE=600

# Requests per minute one client address may make to the unauthenticated
# endpoints (certificate verification, public quotes, sign-up, approval codes).
# 0 turns it off. Default 60. Default: 60.
# API_PUBLIC_RATE_LIMIT_PER_MINUTE=60

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL. Locally this is the container from docker-compose.yml.

# PostgreSQL connection string of the APPLICATION role, `calibra_app` (a login
# that row-level security binds, see DEPLOYMENT.md). Required in production.
DATABASE_URL=postgres://calibra_app:calibra_app@localhost:55432/calibra

# Connections per process (default 5). An unusable value means the default.
# DATABASE_POOL_MAX=5

# Connection string of the table OWNER, for the system path (`systemDb`): the
# few statements that are cross-organization by design (the portal scope
# resolver, the lookups that learn which laboratory a request belongs to, Better
# Auth, asset_type writes). Required while DATABASE_RLS_MODE=enforced (the
# default): start-up refuses to run without it, because the application role
# would silently see nothing on those paths. Migrations (`db:migrate`,
# `db:bootstrap`) run as the owner too.
DATABASE_OWNER_URL=postgres://calibra:calibra@localhost:55432/calibra

# Row-level security (migration 0123). `enforced` (default): the application
# connects as `calibra_app`, which the tenant policies bind, and start-up
# refuses a DATABASE_URL that is the owner of the tables (a connection that RLS
# would not bind) or a missing DATABASE_OWNER_URL. `shadow`: for diagnosis, the
# application connects as the owner, which RLS does not bind, and start-up
# refuses a role that RLS would bind. Default: enforced.
# DATABASE_RLS_MODE=enforced

# ── Addresses and origins ─────────────────────────────────────────────────────
# Public URLs of the deployment (no trailing slash). API_URL equals APP_URL when
# the API is served under /api on the app's own host.

# Public address of the API. Required in production.
API_URL=http://localhost:3000

# Public address of the lab app. Required in production.
APP_URL=http://localhost:5173

# Public address of the client portal (derived from APP_URL when unset).
PORTAL_APP_URL=http://localhost:5174

# Public project site; its origin is trusted by auth and CORS.
# SITE_URL=

# Host of the public certificate-verification page (defaults to PORTAL_APP_URL).
# VERIFY_URL=

# Extra origins allowed by CORS (comma-separated). The APP_URL, PORTAL_APP_URL,
# SITE_URL, API_URL and VERIFY_URL origins are always included.
# CORS_ALLOWED_ORIGINS=

# Extra origins trusted by authentication (comma-separated); the same origins as
# above are always included.
# AUTH_TRUSTED_ORIGINS=

# Share session cookies across subdomains (API on api.example.com serving
# frontends on example.com and portal.example.com), e.g. .example.com.
# AUTH_COOKIE_DOMAIN=.example.com

# ── Authentication ────────────────────────────────────────────────────────────

# Session signing secret, at least 32 characters (generated by setup). Required
# in production.
BETTER_AUTH_SECRET=

# Development only: extra hostnames (tunnels, LAN) accepted by auth.
# AUTH_DEV_ALLOWED_HOSTS=

# Passkeys: relying-party id (defaults derive from APP_URL).
# PASSKEY_RP_ID=

# Passkeys: extra origins (comma-separated).
# PASSKEY_EXTRA_ORIGINS=

# Self-service lab sign-up (corporate e-mail domains only). Default: false.
# PUBLIC_SIGNUP_ENABLED=false

# Service account that owns client-portal organizations (created by the seed /
# init). Required in production.
PORTAL_SERVICE_USER_ID=portal-service

# Seconds a client-portal invitation stays valid. An unusable value means the
# default.
# PORTAL_INVITATION_EXPIRES_IN=604800

# Pepper for public quote approval-code HMACs (random string). Rotating it
# orphans outstanding codes. Required in production.
QUOTE_APPROVAL_CODE_PEPPER=

# ── E-mail ────────────────────────────────────────────────────────────────────
# Sign-in links, invitations and notifications go out over SMTP or through the
# Resend API. Locally SMTP points at Mailpit from docker-compose.yml: read every
# message at http://localhost:8025. In production, point SMTP_* at your mail
# server, or remove them and set RESEND_API_KEY.

# Picks the transport explicitly; only needed when both SMTP_HOST and
# RESEND_API_KEY are set (SMTP wins otherwise).
# EMAIL_TRANSPORT=smtp

# SMTP server host. Leave empty to use Resend.
SMTP_HOST=localhost

# SMTP port (default 587, or 465 with SMTP_SECURE=true).
SMTP_PORT=1025

# Implicit TLS (port 465); otherwise STARTTLS when the server offers it.
# Default: false.
# SMTP_SECURE=true

# SMTP user name.
# SMTP_USER=

# SMTP password.
# SMTP_PASSWORD=

# Resend API key: the platform sender when SMTP_HOST is empty, and the fallback
# for lab sender domains.
# RESEND_API_KEY=

# Sender of platform e-mail, e.g. "Laboratório <calibra@example.com>".
EMAIL_FROM="Calibra Fácil <noreply@example.com>"

# Logo shown in e-mail headers (default: the app's own logo).
# EMAIL_LOGO_URL=

# Signing secret of the Resend delivery webhook (bounces and complaints).
# RESEND_WEBHOOK_SECRET=

# 256-bit base64 key encrypting lab-owned Resend API keys at rest. Without it
# the e-mail-domain settings refuse key intake and every send uses the platform
# sender. Never reuse another key.
EMAIL_DOMAIN_MASTER_KEY=

# ── Object storage (S3-compatible) ────────────────────────────────────────────
# Locally: the S3 container from docker-compose.yml. On Cloudflare R2, remove
# R2_ENDPOINT/R2_REGION and set R2_ACCOUNT_ID instead. Production needs one of
# R2_ACCOUNT_ID or R2_ENDPOINT.

# Cloudflare R2 account id; the S3 endpoint is derived from it unless
# R2_ENDPOINT is set.
# R2_ACCOUNT_ID=

# S3-compatible endpoint of any non-R2 store (the local container, MinIO, AWS
# S3). Takes precedence over R2_ACCOUNT_ID.
R2_ENDPOINT=http://localhost:59000

# The store's public address, when R2_ENDPOINT is an internal one: download
# links are signed for it.
# R2_PUBLIC_ENDPOINT=

# S3 region (default us-east-1 with R2_ENDPOINT, auto on R2).
R2_REGION=us-east-1

# Object-storage access key id. Required in production.
R2_ACCESS_KEY_ID=calibra

# Object-storage secret access key. Required in production.
R2_SECRET_ACCESS_KEY=calibra-dev-secret

# Documents bucket: regulated records (certificates, service-order documents,
# standards). Required in production.
R2_BUCKET_NAME=calibra-documents

# Media bucket: branding and media (logos, signatures, avatars). Required in
# production.
R2_MEDIA_BUCKET_NAME=calibra-media

# ── PDF rendering (Gotenberg) ─────────────────────────────────────────────────

# Gotenberg service that renders HTML and spreadsheets to PDF.
GOTENBERG_URL=http://localhost:3001

# Shared-secret header, only when your Gotenberg sits behind the token gate in
# services/gotenberg.
# GOTENBERG_TOKEN=

# ── Background jobs ───────────────────────────────────────────────────────────
# BACKGROUND_JOBS_MODE: local = the API runs PDF/integration jobs in-process
# (development); queue = jobs wait in the database for apps/worker (polling, or
# woken through DOCUMENT_WORKER_URL); inline = run inside the request (tests).

# Where background jobs run: local, queue or inline. Default: local.
BACKGROUND_JOBS_MODE=local

# queue only: the document worker's drain server, woken after each enqueue.
# DOCUMENT_WORKER_URL=http://document-worker:8080

# Shared secret sent to the document worker's drain server.
# DOCUMENT_WORKER_TOKEN=

# A GENERATING_PDF certificate older than this with no live queue row is
# rejected (default 60 minutes). An unusable value means the default. Default:
# 3600000.
# STUCK_RENDER_AFTER_MS=3600000

# A claimed queue job idle for longer than this is released for another worker
# (default 10 minutes). An unusable value means the default. Default: 600000.
# QUEUE_STALE_AFTER_MS=600000

# Queue idempotency ledger: enforce (default) skips completed duplicates; shadow
# records and logs them but always runs; off disables it. An unrecognised value
# means enforce. Default: enforce.
# QUEUE_RECEIPTS_MODE=enforce

# `internal` runs the cron schedule inside the API process, for installs without
# an external scheduler (the Docker setup turns it on). Any other value leaves
# scheduling to an external trigger. Default: external.
# CRON_SCHEDULER=internal

# Shared secret for the /api/cron/* endpoints (Authorization: Bearer). Without
# it the cron endpoints answer 503. Required in production.
CRON_SECRET=

# ── Desktop sync ──────────────────────────────────────────────────────────────
# SYNC_MIN_DESKTOP_VERSION: the oldest desktop build the cloud still accepts
# pushes from. Unset (default) = no minimum. Once set, an older desktop is
# answered 'update required' (HTTP 426, its queued changes are kept), and an
# execution submit that does not carry the calibration record stamp is held to
# the calibration record rule like every other submit.
#
# SYNC_CHANGE_LOG_RETENTION_DAYS: how long the change log the desktop pull reads
# (protocol 3) is kept. A desktop that stayed offline longer is told to bootstrap
# again instead of pulling; the purge runs from the sync-change-log-purge cron.

# Oldest desktop version allowed to push (MAJOR.MINOR.PATCH). Unset means no
# minimum; setting it also ends the legacy calibration-record exemption.
# SYNC_MIN_DESKTOP_VERSION=1.4.0

# Days the desktop change log is kept (at least 7). A desktop offline for longer
# bootstraps again. An unusable value means the default. Default: 90.
# SYNC_CHANGE_LOG_RETENTION_DAYS=90

# ── Integrations and public API ───────────────────────────────────────────────
# Conta Azul ERP: not needed, each laboratory registers its own application in
# Configurações → Integrações. Set CONTA_AZUL_* to supply one application to every
# laboratory on this server instead; the redirect URL defaults to
# API_URL + /api/integrations/conta-azul/oauth/callback.

# 256-bit base64 key encrypting integration tokens at rest (generated by setup).
# Never reuse another key. Required in production.
INTEGRATIONS_MASTER_KEY=

# 256-bit base64 key encrypting public-API webhook secrets at rest (generated by
# setup). Never reuse another key. Required in production.
PUBLIC_API_MASTER_KEY=

# Conta Azul application supplied to every laboratory: client id.
# CONTA_AZUL_CLIENT_ID=

# Conta Azul application supplied to every laboratory: client secret.
# CONTA_AZUL_CLIENT_SECRET=

# Overrides the Conta Azul OAuth redirect URL.
# CONTA_AZUL_OAUTH_REDIRECT_URI=

# ── Outbound requests to customer-configured URLs ─────────────────────────────
# Public-API webhooks and the generic HTTP ERP integration call URLs a laboratory
# configures. Those requests resolve the host once, refuse private, loopback,
# link-local, CGNAT and multicast addresses (so a configured URL cannot reach the
# database, the object store or the PDF service on the internal network), do not
# follow redirects to such addresses and cap the time and the response size.

# Comma-separated hosts the server may call even though they resolve to a
# private address, for a self-hosted laboratory whose ERP lives on its LAN. Each
# entry is a host name (`erp.lan`), a `*.suffix` wildcard, an IP address or a
# CIDR range (`10.20.0.0/24`). A host name permits ANY address it resolves to
# (loopback and the internal network included), so list a name only if you
# control its DNS; an IP address or CIDR range permits exactly those addresses.
# Off by default: list only what you mean to reach.
# OUTBOUND_ALLOW_PRIVATE_HOSTS=erp.lan,10.20.0.0/24

# `true` lets customer-configured URLs use plain http in production. Outside
# production (development, tests) http is always allowed. Default: false.
# OUTBOUND_ALLOW_INSECURE_HTTP=false

# ── Certificate signing (ICP-Brasil) ──────────────────────────────────────────
# RFC 3161 time-stamping (PAdES-T). With SIGNING_TSA_URL unset, certificates are
# signed without a time-stamp. When it is set, stamping is fail-closed: a TSA
# failure fails the certificate job instead of emitting an unstamped PDF.

# The current key encryption key (KEK): 256-bit base64 key that wraps the data
# keys protecting the laboratories' signing certificates (P12 and password) at
# rest (generated by setup). Never reuse another key. To rotate it, see
# DEPLOYMENT.md (SIGNING_MASTER_KEY_ID, SIGNING_MASTER_KEY_PREVIOUS, then
# `reencrypt-signing-credentials`); never just replace it. Required in
# production.
SIGNING_MASTER_KEY=

# Id of the current KEK, stored with every credential sealed under it (1-64
# letters, digits, `_`, `.` or `-`). Unset: `k1`. Give a rotated key a new id.
# SIGNING_MASTER_KEY_ID=k1

# Previous KEKs that stored credentials may still be sealed under, as
# comma-separated `id:base64key` entries. Keep a key here until
# `reencrypt-signing-credentials` has moved every credential to the current one.
# SIGNING_MASTER_KEY_PREVIOUS=k1:<base64 key>

# Path of a PEM bundle of root certificates that REPLACES the bundled ICP-Brasil
# trust store when a signing certificate is uploaded (homologation roots, an
# updated ITI bundle). Unset: the bundled ICP-Brasil roots.
# SIGNING_TRUST_STORE_FILE=/etc/calibra/icp-brasil-roots.pem

# RFC 3161 time-stamp authority endpoint. In local or inline job mode an
# unreachable authority rejects the job on the first try, so leave it unset in
# development.
# SIGNING_TSA_URL=

# Full Authorization header value for a contracted time-stamp authority (e.g.
# `Basic ...` or `Bearer ...`).
# SIGNING_TSA_AUTH=

# `true` only when the endpoint is a credentialed ICP-Brasil authority;
# otherwise signatures record icpBrasilConformant=false. Default: false.
# SIGNING_TSA_ICP_CONFORMANT=false

# Time-stamp request timeout in milliseconds (1000 to 60000). Unset: 30000.
# Capped at 60 s so four tries (plus 7 s of back-off) stay under the queue
# function's 300 s limit. A request that times out fails the certificate job
# (fail-closed).
# SIGNING_TSA_TIMEOUT_MS=30000

# ── Records retention ─────────────────────────────────────────────────────────
# See docs/architecture/records-retention.md and DEPLOYMENT.md. The records-purge
# cron does nothing unless RECORDS_PURGE_ENABLED=true, and even then it only LOGS
# what it would purge unless RECORDS_PURGE_MODE=execute.

# Enables the records-purge cron. Only `true` enables it; anything else keeps it
# off. Default: false.
# RECORDS_PURGE_ENABLED=false

# `execute` deletes eligible records; anything else (the default dry-run) only
# logs what would be purged. Default: dry-run.
# RECORDS_PURGE_MODE=dry-run

# ── Logs and errors ───────────────────────────────────────────────────────────
# There is no error-tracking service and no DSN: unhandled errors are written as
# one redacted JSON line on stderr. These only label those lines.

# Bearer token of GET /api/metrics (Prometheus text format: requests, latency,
# queue depth, dead letters, cron age). Unset: the endpoint answers 404.
# METRICS_TOKEN=a-long-random-token
