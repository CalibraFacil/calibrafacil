# Calibra Fácil API — environment variables.
#
# `pnpm setup:dev` copies this file to apps/api/.env (gitignored) and fills the
# empty secrets with random values. The defaults point at the services started
# by docker-compose.yml, so local development needs no external account.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://calibra:calibra@localhost:55432/calibra
API_URL=http://localhost:3000
APP_URL=http://localhost:5173
PORTAL_APP_URL=http://localhost:5174

# Session signing secret, at least 32 characters (generated by setup).
BETTER_AUTH_SECRET=

# Service account that owns client-portal organizations (created by the seed).
PORTAL_SERVICE_USER_ID=portal-service

# ── Email ────────────────────────────────────────────────────────────────────
# Every email goes through the Resend SDK. Locally RESEND_BASE_URL points at the
# relay in docker-compose.yml, which delivers to Mailpit: http://localhost:8025.
# In production, remove RESEND_BASE_URL and use a real Resend API key.
RESEND_API_KEY=re_local_development
RESEND_BASE_URL=http://localhost:3025
RESEND_FROM_EMAIL="Calibra Fácil <noreply@example.com>"

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# Locally: the S3 container from docker-compose.yml. On Cloudflare R2, remove
# R2_ENDPOINT/R2_REGION and set R2_ACCOUNT_ID instead.
R2_ENDPOINT=http://localhost:59000
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=calibra
R2_SECRET_ACCESS_KEY=calibra-dev-secret
# Documents bucket: regulated records (certificates, service-order documents, standards).
R2_BUCKET_NAME=calibra-documents
# Media bucket: branding and media (logos, signatures, avatars).
R2_MEDIA_BUCKET_NAME=calibra-media
# R2_ACCOUNT_ID=

# ── PDF rendering (Gotenberg) ────────────────────────────────────────────────
GOTENBERG_URL=http://localhost:3001
# Shared-secret header, only when your Gotenberg sits behind the token gate in
# services/gotenberg.
# GOTENBERG_TOKEN=

# ── Background jobs ──────────────────────────────────────────────────────────
# local  = the API runs PDF/integration jobs in-process (development).
# vercel = jobs are published to Vercel Queue and consumed by apps/worker.
BACKGROUND_JOBS_MODE=local
# Shared secret for the cron endpoints (generated by setup).
CRON_SECRET=

# ── Encryption keys: 32 random bytes, base64 (generated by setup) ────────────
# Never reuse one key for two purposes.
SIGNING_MASTER_KEY=
INTEGRATIONS_MASTER_KEY=
PUBLIC_API_MASTER_KEY=
EMAIL_DOMAIN_MASTER_KEY=
# Pepper for public quote approval-code HMACs (random string).
QUOTE_APPROVAL_CODE_PEPPER=

# ── Deployment (production) ──────────────────────────────────────────────────
# Share session cookies across subdomains (API on api.example.com serving
# frontends on example.com and portal.example.com).
# AUTH_COOKIE_DOMAIN=.example.com
# Extra origins trusted by auth / allowed by CORS (comma-separated). The
# APP_URL, PORTAL_APP_URL, SITE_URL and VERIFY_URL origins are always included.
# AUTH_TRUSTED_ORIGINS=
# CORS_ALLOWED_ORIGINS=
# SITE_URL=
# VERIFY_URL=
# Development only: extra hostnames (tunnels, LAN) accepted by auth.
# AUTH_DEV_ALLOWED_HOSTS=
# Passkeys: relying-party id and extra origins (defaults derive from APP_URL).
# PASSKEY_RP_ID=
# PASSKEY_EXTRA_ORIGINS=

# ── Optional integrations ────────────────────────────────────────────────────
# Self-service lab sign-up (corporate e-mail domains only).
# PUBLIC_SIGNUP_ENABLED=false
# Conta Azul ERP integration.
# CONTA_AZUL_CLIENT_ID=
# CONTA_AZUL_CLIENT_SECRET=
# CONTA_AZUL_OAUTH_REDIRECT_URI=
# Server-side error tracking (Sentry DSN). Unset = reporting off. Events are
# redacted (structural tags + sanitized message + stack) before leaving the process.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
