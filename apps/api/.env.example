# Local development variables for API
# Copy this file to .env and fill in the values
# .env is gitignored and loaded by the Bun API dev runtime

# Authentication secret for better-auth
BETTER_AUTH_SECRET=your-secret-here

# Resend API key for sending emails
RESEND_API_KEY=re_xxx

# Sender address used by portal invitation emails
RESEND_FROM_EMAIL="Calibra Facil <noreply@calibrafacil.com>"

# Service account user id that owns CLIENT organizations
PORTAL_SERVICE_USER_ID=replace-with-better-auth-user-id

# Local app URLs
API_URL=http://localhost:3000
APP_URL=http://localhost:5173
PORTAL_APP_URL=http://localhost:5174

# Optional invitation expiration in seconds (default: 604800 = 7 days)
PORTAL_INVITATION_EXPIRES_IN=604800

# R2 object storage
R2_ACCOUNT_ID=your-r2-account-id
# Documents bucket: regulated records (certs, service-order docs, standards, sync)
R2_BUCKET_NAME=calibrafacil-documents
# Media bucket: branding/media (logos, signatures, avatars, template sources)
R2_MEDIA_BUCKET_NAME=calibrafacil-media
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-here
CHROMIUM_PACK_R2_BUCKET=calibrafacil-runtime-assets
CHROMIUM_PACK_R2_KEY=chromium-v148.0.0-pack.x64.tar
CHROMIUM_PACK_URL=

DATABASE_URL=postgresql://user:pass@host/db
DATABASE_POOL_MAX=1

# Local = API starts PDF/integration jobs in-process.
# Vercel = publish to Vercel Queue.
BACKGROUND_JOBS_MODE=local
BACKGROUND_JOBS_TOPIC=calibra-facil-background-jobs
VERCEL_QUEUE_REGION=gru1
CRON_SECRET=replace-with-random-secret

ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=your-asaas-webhook-token
BACKOFFICE_BOOTSTRAP_TOKEN=your-backoffice-bootstrap-token
PUBLIC_API_MASTER_KEY=your-public-api-master-key
INTEGRATIONS_MASTER_KEY=your-integrations-master-key
SIGNING_MASTER_KEY=your-signing-master-key
INTERNAL_OPERATOR_EMAILS=ops@example.com
