# Local development variables for API
# Copy this file to .dev.vars and fill in the values
# .dev.vars is gitignored and will be used by wrangler dev

# Authentication secret for better-auth
BETTER_AUTH_SECRET=your-secret-here

# Resend API key for sending emails
RESEND_API_KEY=re_xxx

# R2 secret access key for certificate storage
R2_SECRET_ACCESS_KEY=your-r2-secret-here

# Local database connection string for Hyperdrive
# This overrides the Hyperdrive binding in local development
# HYPERDRIVE_LOCAL_CONNECTION_STRING=postgresql://user:pass@host/db
