{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "pnpm install --frozen-lockfile --filter \"@calibra-facil/portal...\"",
  "buildCommand": "bun node_modules/vite/bin/vite.js build",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs portal",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
