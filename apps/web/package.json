    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.0",
    "@types/react-is": "19.2.0",
    "@types/w3c-web-serial": "^1.0.7",
