{
  "name": "@calibra-facil/web",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:bun": "bun node_modules/vite/bin/vite.js --port 5173 --host",
    "build": "vite build",
    "build:ci": "vite build && node ./scripts/check-bundle-size.mjs",
    "check:bundle": "node ./scripts/check-bundle-size.mjs",
    "render:og": "node ./scripts/render-og.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:stack": "playwright test --config playwright.stack.config.ts",
    "lint": "oxlint",
    "check-types": "node ../../scripts/typecheck.mjs --noEmit",
    "format": "prettier",
    "check": "prettier --write . && oxlint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@calibra-facil/auth": "workspace:^",
