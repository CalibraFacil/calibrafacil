{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "pnpm install --frozen-lockfile --filter \"@calibra-facil/web...\"",
  "buildCommand": "bun node_modules/vite/bin/vite.js build",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://calibra-facil-cms.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://calibra-facil-cms.vercel.app/blog/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://docs.calibrafacil.com/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.calibrafacil.com/docs/:path*"
    },
    {
      "source": "/recursos",
      "destination": "https://calibra-facil-site.vercel.app/recursos"
    },
    {
      "source": "/recursos/:path*",
      "destination": "https://calibra-facil-site.vercel.app/recursos/:path*"
    },
    {
      "source": "/solucoes",
      "destination": "https://calibra-facil-site.vercel.app/solucoes"
    },
    {
      "source": "/solucoes/:path*",
      "destination": "https://calibra-facil-site.vercel.app/solucoes/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://calibra-facil-site.vercel.app/_next/:path*"
    },
    {
      "source": "/",
      "destination": "https://calibra-facil-site.vercel.app/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
