{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "bun ../../scripts/setup-private-git-ssh.mjs --required && pnpm install --frozen-lockfile --filter \"@calibra-facil/web...\"",
  "buildCommand": "bun node_modules/vite/bin/vite.js build",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://blog.calibrafacil.com/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://blog.calibrafacil.com/blog/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
