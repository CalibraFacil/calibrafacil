// Cloudflare Workers static assets: the built site is served as-is, with no
// Worker script. Static asset requests are free on every plan. Headers and
// redirects live in public/_headers and public/_redirects.
{
  // The Worker that serves calibrafacil.com; Workers Builds deploys it from
  // this directory on every push to main.
  "name": "calibrafacil",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
