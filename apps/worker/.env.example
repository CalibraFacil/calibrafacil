# Calibra Fácil worker — environment variables.
#
# Optional in development: with BACKGROUND_JOBS_MODE=local the API runs jobs
# in-process. Run the worker (`pnpm dev:worker`) to exercise the database job
# queue as production does. Copy to apps/worker/.env (gitignored); the values
# must match apps/api/.env.

DATABASE_URL=postgres://calibra:calibra@localhost:55432/calibra
APP_URL=http://localhost:5173
PORTAL_APP_URL=http://localhost:5174

# Object storage (S3-compatible). On Cloudflare R2, drop R2_ENDPOINT/R2_REGION
# and set R2_ACCOUNT_ID.
R2_ENDPOINT=http://localhost:59000
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=calibra
R2_SECRET_ACCESS_KEY=calibra-dev-secret
R2_BUCKET_NAME=calibra-documents
R2_MEDIA_BUCKET_NAME=calibra-media

# HTML → PDF rendering.
GOTENBERG_URL=http://localhost:3001
# GOTENBERG_TOKEN=

# E-mail over SMTP (Mailpit locally: http://localhost:8025), or RESEND_API_KEY.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Calibra Fácil <noreply@example.com>"

# Same keys as apps/api/.env (32 random bytes, base64).
SIGNING_MASTER_KEY=
INTEGRATIONS_MASTER_KEY=
EMAIL_DOMAIN_MASTER_KEY=
