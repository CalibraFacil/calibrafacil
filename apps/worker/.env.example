# Local development variables for Worker
# Copy this file to .env and fill in the values
# .env is gitignored and loaded by the Bun worker dev runtime

DATABASE_URL=postgresql://user:pass@host/db
R2_ACCOUNT_ID=your-r2-account-id
# Documents bucket: regulated records (certs, service-order docs, standards, sync)
R2_BUCKET_NAME=calibrafacil-documents
# Media bucket: branding/media (logos, signatures, avatars, template sources)
R2_MEDIA_BUCKET_NAME=calibrafacil-media
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
CHROMIUM_PACK_R2_BUCKET=calibrafacil-runtime-assets
CHROMIUM_PACK_R2_KEY=chromium-v148.0.0-pack.x64.tar
CHROMIUM_PACK_URL=
SIGNING_MASTER_KEY=your-signing-master-key
INTEGRATIONS_MASTER_KEY=your-integrations-master-key
