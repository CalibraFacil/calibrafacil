{
  "name": "calibra-facil",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup:dev": "node scripts/dev-setup.mjs",
    "setup:prod": "sh deploy/setup.sh",
    "services:up": "docker compose up --detach --wait",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs --follow",
    "build": "turbo run build",
    "bench:api": "node scripts/bench-api.mjs",
    "bench:api:bun": "bun scripts/bench-api.mjs",
    "test:desktop-release-gate": "node scripts/build-desktop-artifact.test.mjs",
    "test:desktop-release-local-gates": "pnpm test:desktop-release-gate",
    "check:blocked-deps": "node scripts/check-blocked-deps.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "dev": "turbo run dev --filter=@calibra-facil/api --filter=@calibra-facil/web --filter=@calibra-facil/portal",
    "dev:isolated": "node scripts/dev-runner.mjs",
    "test:dev-runner": "node scripts/dev-runner.test.mjs",
    "dev:all": "turbo run dev",
    "dev:docs": "pnpm --dir apps/docs run dev",
    "dev:site": "pnpm --dir apps/site run dev",
    "dev:desktop": "turbo run dev --filter=@calibra-facil/web --filter=@calibra-facil/desktop",
    "dev:email": "pnpm --dir packages/email run dev",
    "dev:local-server": "pnpm --dir apps/local-server run dev",
    "dev:worker": "pnpm --dir apps/worker dev",
    "build:desktop": "node scripts/build-desktop-artifact.mjs --dir",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.mjs",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.mjs --linux",
    "dist:desktop:mac": "node scripts/build-desktop-artifact.mjs --mac",
    "dist:desktop:win": "node scripts/build-desktop-artifact.mjs --win",
    "smoke:desktop:electron": "node scripts/smoke-desktop-electron.mjs",
    "smoke:desktop:artifact": "node scripts/smoke-desktop-artifact.mjs",
    "smoke:desktop:local-server": "node scripts/smoke-desktop-local-server.mjs",
    "smoke:desktop:packaged-offline": "node scripts/smoke-desktop-packaged-offline.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "better-sqlite3": "^12.11.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "engines": {
    "node": ">=24"
  }
}
