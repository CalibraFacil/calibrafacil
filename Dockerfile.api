# The API: the Hono app on Bun (apps/api/src/bun.ts), which also serves the
# scheduled jobs under /api/cron/*. Build from the repository root:
#
#   docker build -f Dockerfile.api -t calibrafacil-api .
#
# Configure it with the environment variables listed in DEPLOYMENT.md.
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build

# pnpm itself comes from the "packageManager" field of package.json.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /repo
COPY . .
# Only the API and the workspace packages it imports, without dev tooling.
RUN pnpm install --frozen-lockfile --prod --filter "@calibra-facil/api..."

# The Bun of .bun-version (what CI runs), pinned by digest; Dependabot bumps both.
FROM oven/bun:1.4.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4

ENV NODE_ENV=production
WORKDIR /repo

# Workspace packages ship TypeScript source, which Bun runs directly.
COPY --from=build /repo/package.json ./
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/apps/api ./apps/api

WORKDIR /repo/apps/api
# Run as the image's unprivileged user (uid 1000). The application is read-only
# on disk: everything it keeps goes to the database and the object store.
USER bun
EXPOSE 3000
CMD ["bun", "src/bun.ts"]
