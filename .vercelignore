apps/api/test
apps/api/vercel-functions
apps/api/src/**/__tests__
apps/api/src/**/__tests__/**
apps/api/src/**/*.spec.ts
apps/api/src/**/*.test.ts
**/__tests__
**/__tests__/**
**/*.spec.ts
**/*.test.ts
**/vitest.config.ts
packages/email/.react-email
packages/email/node_modules

# Non-API app build outputs (docs/.next is ~37MB). The API is
# bundled by esbuild from fresh vercel-src/ source and never reads these, so
# excluding them only shrinks the post-deploy build cache (off critical path).
apps/web/dist
apps/portal/dist
apps/local-server/dist
apps/desktop/dist
apps/docs/.next

# TypeScript incremental caches — regenerated each deploy, never reused across
# Vercel's fresh build clones.
**/*.tsbuildinfo

# Turbo caches from non-API workspaces — unused by the API build, which is
# scoped via `--filter @calibra-facil/api...`. apps/api/.turbo is kept.
apps/web/.turbo
apps/portal/.turbo
apps/docs/.turbo
apps/desktop/.turbo
apps/local-server/.turbo
apps/worker/.turbo
packages/**/.turbo
