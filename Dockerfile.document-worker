# The document worker as an HTTP drain server (apps/worker/src/serve.ts): it
# sleeps until the API pings POST /drain after enqueueing an `app_queue_job`
# row, drains the queue and goes idle again, so the database is only touched
# when there is work. Renders through Gotenberg (GOTENBERG_URL).
#
# services/document-worker deploys it as a Cloudflare Container: its
# wrangler.jsonc builds this file with the repository root as the context.
# Anywhere else, build from the repository root:
#
#   docker build -f Dockerfile.document-worker -t calibrafacil-document-worker .
FROM node:25-bookworm-slim AS build

# pnpm itself comes from the "packageManager" field of package.json.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /repo
COPY . .
# pnpm-workspace.yaml asks for native binaries for every platform a hosted
# build may run on; an image only needs its own.
RUN sed -i '/^supportedArchitectures:/,/^[^ ]/{/^supportedArchitectures:/d;/^ /d}' pnpm-workspace.yaml
# Only the worker and the workspace packages it imports, without dev tooling.
RUN pnpm install --frozen-lockfile --prod --filter "@calibra-facil/worker..."

FROM oven/bun:1-slim

ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /repo

# Workspace packages ship TypeScript source, which Bun runs directly.
COPY --from=build /repo/package.json ./
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/apps/worker ./apps/worker

WORKDIR /repo/apps/worker
EXPOSE 8080
CMD ["bun", "src/serve.ts"]
