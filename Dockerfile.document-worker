# Document-assembly queue worker, deployed as a Cloudflare Container
# (services/document-worker). Drains `app_queue_job` render jobs — calibration
# certificates, service-order PDFs, the PDF-label job — off the Vercel queue
# function. Runs the HTTP drain server (apps/worker/src/serve.ts).
#
# Built from the repo ROOT: services/document-worker/wrangler.jsonc sets
# image_build_context = ../../ so `COPY . .` brings in the whole pnpm monorepo.
# Every dependency (incl. @calibra-facil/math-engine) is a workspace package, so
# `pnpm install` needs no private-git auth — `wrangler deploy` builds this
# directly, no BuildKit secret required.
#
# node:24-bookworm-slim is glibc, so @resvg/resvg-js installs its prebuilt
# binary cleanly — none of the musl pain the Vercel build has to externalize.
FROM node:24-bookworm-slim

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV CHROME_EXECUTABLE_PATH=/usr/bin/chromium
ENV NODE_ENV=production
ENV PORT=8080

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip chromium fonts-liberation \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@11.3.0 \
  && curl -fsSL https://bun.sh/install | bash

ENV PATH="/root/.bun/bin:${PATH}"
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

EXPOSE 8080
CMD ["bun", "apps/worker/src/serve.ts"]
