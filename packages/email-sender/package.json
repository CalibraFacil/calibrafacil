    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@calibra-facil/db": "workspace:*",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^24.13.0",
    "drizzle-orm": "^0.45.2",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  }
