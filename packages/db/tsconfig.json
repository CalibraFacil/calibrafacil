{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDirs": ["src", "./"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
