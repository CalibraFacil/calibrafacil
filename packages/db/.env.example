# Used by drizzle-kit (db:migrate, db:studio), db:bootstrap and the seed scripts.
# `pnpm setup:dev` copies this file to packages/db/.env.
#
# This is the table OWNER: the connection that changes the schema and seeds
# (the application itself connects as calibra_app, see apps/api/.env).
DATABASE_URL=postgres://calibra:calibra@localhost:55432/calibra
