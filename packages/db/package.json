{
  "name": "@calibra-facil/db",
  "type": "module",
  "version": "1.0.0",
  "exports": {
    ".": "./src/db.ts",
    "./queue": "./src/queue.ts",
    "./queue-receipts": "./src/queue-receipts.ts",
    "./queue-render-recovery": "./src/queue-render-recovery.ts",
    "./records-retention": "./src/records-retention.ts",
    "./schema": "./src/schema.ts",
    "./tenancy": "./src/tenancy.ts",
    "./seed-asset-types": "./src/seed-asset-types.ts",
    "./seed-legal-metrology-regulations": "./src/seed-legal-metrology-regulations.ts"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude=dist/**",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "node ./scripts/bootstrap.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 4000",
    "db:seed:legal-metrology-regulations": "tsx ./src/seed-legal-metrology-regulations.ts",
    "security:migrate-p12": "node ./scripts/migrate-p12-encryption.mjs",
    "db:audit:method-dimensions": "tsx ./scripts/audit-method-dimensions.mjs",
    "lint": "oxlint",
    "check-types": "node ../../scripts/typecheck.mjs --noEmit",
    "retention:inventory": "tsx ./scripts/records-retention-inventory.ts",
    "tenancy:doc": "tsx ./scripts/tenancy-doc.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@calibra-facil/config": "workspace:^",
    "@calibra-facil/schemas": "workspace:^",
    "@calibra-facil/shared": "workspace:^",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "kysely": "^0.28.17",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@calibra-facil/method-definition": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^24.13.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
