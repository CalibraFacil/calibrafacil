{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn"],
  "jsPlugins": [
    "./packages/oxlint-plugin-calibra/src/index.ts",
    "@shadcn/lint"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "perf": "warn",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "Direct useEffect is banned. Use derived state, event handlers, data-fetching hooks, keyed remounts, or useMountEffect (apps/<app>/src/hooks/use-mount-effect.ts)."
          }
        ],
        "patterns": [
          {
            "group": ["@calibra-facil/db/testing"],
            "message": "@calibra-facil/db/testing holds test seams for the transaction scope: tests and test harnesses only (the override below lists them), never production code."
          }
        ]
      }
    ],
    // The same ban through the default import: `import React from "react"` then
    // `React.useEffect(...)` never names `useEffect` in an import specifier.
    "no-restricted-properties": [
      "error",
      {
        "object": "React",
        "property": "useEffect",
        "message": "Direct useEffect is banned. Use derived state, event handlers, data-fetching hooks, keyed remounts, or useMountEffect (apps/<app>/src/hooks/use-mount-effect.ts)."
      }
    ],
    // React Compiler diagnostic, not a defect: it fires on third-party APIs
    // whose return values the compiler cannot memoize (TanStack Table's
    // `useReactTable`, react-hook-form's `watch`). There is no call-site fix,
    // and this repo does not run React Compiler, so keep it advisory instead
    // of failing the build on a library's design.
    "react/incompatible-library": "warn",
    // Promoted from the advisory `suspicious` tier after the existing sites were
    // fixed (#930): these read as real defects, not style.
    // `allowAsProps` keeps render props (DataTable `bulkActions`, Recharts
    // `formatter`) out of scope — the receiver calls them as functions, so they
    // are not unstable element types.
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    "react/jsx-no-constructed-context-values": "error",
    "react/memo-dependencies": "error",
    "react/iframe-missing-sandbox": "error",
    "eslint/preserve-caught-error": "error",
    "calibra/no-api-import-in-frontend": "error",
    "calibra/no-hono-client-outside-client-runtime": "error",
    "calibra/no-calibration-job-update-outside-owner": "error",
    "calibra/no-job-audit-insert-outside-owner": "error",
    "calibra/no-raw-locale-formatting": "error",
    "calibra/no-json-error-body-in-routes": "error",
    "calibra/no-raw-db-in-routes": "error",
    "calibra/no-router-coupling-in-features": "error",
    "calibra/no-process-env": "error",
    "calibra/no-unparsed-portal-fetch": "error",
    "calibra/no-raw-palette-color-classes": "error",
    "calibra/no-app-ui-primitive-recreation": "error"
  },
  "overrides": [
    {
      // Test code may use the db test seams; the useEffect ban stays.
      "files": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/*/test/**",
        "packages/db/src/testing.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "Direct useEffect is banned. Use derived state, event handlers, data-fetching hooks, keyed remounts, or useMountEffect (apps/<app>/src/hooks/use-mount-effect.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/*/src/hooks/use-mount-effect.ts",
        "packages/ui/src/hooks/use-mount-effect.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".repos",
    "dist",
    ".next",
    "out",
    "build",
    "coverage",
    "apps/api/api/**/*.js",
    "*.config.js",
    "*.config.ts",
    "*.config.mjs",
    "routeTree.gen.ts"
  ]
}
