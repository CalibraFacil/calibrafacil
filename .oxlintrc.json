{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "perf": "warn",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "Direct useEffect is banned. Use derived state, event handlers, data-fetching hooks, keyed remounts, or useMountEffect (apps/<app>/src/hooks/use-mount-effect.ts)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/*/src/hooks/use-mount-effect.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".repos",
    "dist",
    ".next",
    "out",
    "build",
    "coverage",
    "apps/api/api/**/*.js",
    "*.config.js",
    "*.config.ts",
    "*.config.mjs",
    "routeTree.gen.ts",
    "apps/cms/src/payload-types.ts",
    "apps/cms/src/app/(payload)/admin/importMap.js"
  ]
}
